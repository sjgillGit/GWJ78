[sub_resource type="GDScript" id="GDScript_q05a6"]
script/source = "extends AudioStreamPlayer

const bg_music = preload(\"res://Assets/sound/bg_music.ogg\")


func _play_music(music: AudioStream, volume = 0.0):
	if stream == music:
		return
		
	stream = music
	volume_db = volume
	play()

func _play_music_bg():
	_play_music(bg_music)
"

